          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./app.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text"
    },
    "enctype": "application/x-www-form-urlencoded"
  },
