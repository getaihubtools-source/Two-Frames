{
  "id": "./?app=duoframe",
  "name": "دوقاب | کدساز عکس عاشقانه",
  "short_name": "دوقاب",
  "lang": "fa",
  "dir": "rtl",
  "description": "۳۲۰ کد عکس عاشقانه؛ سازنده پرامپت برای ساخت و ویرایش تصویر، برنامه‌ریز آلبوم و شات‌لیست عکاس",
  "start_url": "./app.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0B0B14",
  "theme_color": "#0B0B14",
  "categories": [
    "photography",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "سازنده پرامپت",
      "short_name": "سازنده",
      "url": "./app.html?tab=build&source=shortcut",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "برنامه‌ریز آلبوم",
